{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hydra",
  "version": "0.1.0",
  "identifier": "com.hydra.downloader",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Hydra",
        "width": 880,
        "height": 640,
        "minWidth": 700,
        "minHeight": 540,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 24 },
        "backgroundColor": "#151519"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
